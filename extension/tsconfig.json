{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["chrome"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@app/*": ["../src/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.content.config.ts"]
}
